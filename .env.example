# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data & Storage
PARQUET_DIR=data/parquet
DUCKDB_PATH=data/industrial.duckdb

# MCP Configuration
MCP_SERVER_NAME=Industrial-Telemetry-MCP
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Stream Simulation
STREAM_TICK_RATE_MS=1000
STREAM_DEFAULT_SPEED=1.0

# ---------------------------------------------------------------------------
# LLM & Multi-Agent Configuration (LangGraph System 2)
# ---------------------------------------------------------------------------
# Provedor ativo: openrouter | gemini | openai | mock (fallback heurístico local)
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-3.8-flash
LLM_FALLBACK_MODEL=deepseek/deepseek-v4-flash
LLM_DECISION_MODEL=typesafe/jev-latest

# Chaves de API das LLMs (preencha ao menos uma de sua preferência)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# FinOps, Caching Semântico & Orçamento de Tokens
# ---------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
MAX_DAILY_TOKEN_BUDGET=100000
